{
  "name": "reception-inbox-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Reception inbox auditor — POC + customer-deployable package",
  "type": "module",
  "main": "functions/dist/functions/app.js",
  "scripts": {
    "start": "bun run src/auto-log.ts",
    "list:create": "bun run scripts/create-list.ts",
    "list:teardown": "bun run scripts/teardown-list.ts",
    "seed": "bun run scripts/seed-emails.ts",
    "seed:2": "bun run scripts/seed-emails-2.ts",
    "reclassify": "bun run scripts/reclassify.ts",
    "hub": "bun run scripts/build-hub-page.ts",
    "stats": "bun run scripts/stats.ts",
    "compliance": "bun run scripts/compliance-page.ts",
    "package:init": "bun run scripts/package-init.ts",
    "fn:build": "tsc -p tsconfig.fn.json",
    "fn:clean": "rm -rf functions/dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.fn.json --noEmit"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.14.0",
    "@azure/identity": "^4.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "dotenv": "^16.4.5",
    "luxon": "^3.5.0",
    "openai": "^4.65.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/luxon": "^3.4.2",
    "@types/node": "^25.6.2",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3"
  }
}
