# ─── Microsoft 365 / Graph ────────────────────────────────────────
M365_TENANT_ID=197609ee-9f62-4b85-b8b0-d3e2b6c1d4b4
# Azure AD app registration ID (delegated, dev-only — m365 CLI public app)
M365_CLIENT_ID=
# Watched mailbox (must be a SharedMailbox in customer tenant)
WATCHED_MAILBOX=demonstration@smecai.au

# ─── Graph auth mode ──────────────────────────────────────────────
# "cli" (default) → piggybacks m365 CLI's delegated token — dev only
# "app"           → uses ClientSecretCredential — required for Azure Function prod
GRAPH_AUTH_MODE=cli
# Only required when GRAPH_AUTH_MODE=app:
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ─── SharePoint ───────────────────────────────────────────────────
SP_HOSTNAME=smecai.sharepoint.com
SP_SITE_PATH=/sites/AIApplications
SP_LIST_NAME=Reception Email Tracker

# ─── Azure OpenAI (Australia East, AAD via DefaultAzureCredential) ─
AZURE_OPENAI_ENDPOINT=https://email-ai-openai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-nano
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ─── Cursor state backend ─────────────────────────────────────────
# "file"  (default) → .state/cursor.json on local filesystem (dev)
# "table"           → Azure Table Storage (Azure Function prod — ephemeral fs)
CURSOR_STORE=file
# Only required when CURSOR_STORE=table:
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_TABLE=cursors
# Optional override for file mode:
CURSOR_FILE_PATH=.state/cursor.json
